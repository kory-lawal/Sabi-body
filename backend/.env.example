# SabiBody FastAPI backend (Render). Copy to backend/.env for local use.
# Never commit real values; backend/.env is git-ignored.

# --- Voice coaching
YARNGPT_API_KEY=
YARNGPT_BASE_URL=https://api.yarngpt.ai

# --- Runtime
PYTHON_ENV=development               # set to "production" on Render
SABI_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5175,http://localhost:5176
FRONTEND_URL=http://localhost:5176   # production: https://your-app.vercel.app (used in email links)

# --- Neon PostgreSQL (Neon console > your project > Connect > pooled connection string)
# Example: postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# --- Authentication
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET_KEY=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
REQUIRE_EMAIL_VERIFICATION=true
# COOKIE_SECURE defaults to true in production, false in development.
# Comma-separated emails that become admins after verifying their address.
ADMIN_BOOTSTRAP_EMAILS=

# --- Email (Resend). Without RESEND_API_KEY, emails are only written to the server log.
RESEND_API_KEY=
EMAIL_FROM=SabiBody <hello@your-verified-domain.com>

# --- Scheduled reminders (bearer token for POST /api/internal/reminders/run)
CRON_SECRET=
